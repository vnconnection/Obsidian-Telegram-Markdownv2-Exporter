{
  "name": "telegram-markdownv2-exporter",
  "version": "0.1.0",
  "private": true,
  "description": "Copy the current Obsidian note to the clipboard as Telegram MarkdownV2.",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "release": "node release.mjs validate",
    "release:classify": "node release.mjs classify",
    "release:prepare": "node release.mjs prepare",
    "release:validate": "node release.mjs validate",
    "release:package": "node release.mjs package",
    "release:patch": "node release.mjs prepare --impact patch",
    "release:minor": "node release.mjs prepare --impact minor",
    "release:major": "node release.mjs prepare --impact major"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
